{
  "name": "game-of-life-tribes",
  "version": "1.0.0",
  "author": "Riccardo Chimisso",
  "license": "MIT",
  "homepage": "https://game-of-life-tribes.dev/",
  "bugs": {
    "url": "https://github.com/rChimisso/game-of-life-tribes/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rChimisso/game-of-life-tribes.git"
  },
  "scripts": {
    "ng": "ng",
    "serve": "pnpm run wiki:compile && ng serve",
    "wiki:compile": "node scripts/wiki/compile-wiki.mjs",
    "build": "pnpm run wiki:compile && ng build && node scripts/wiki/finalize-build.mjs",
    "build:patch": "npm version patch --no-git-tag-version && pnpm run build",
    "build:minor": "npm version minor --no-git-tag-version && pnpm run build",
    "build:major": "npm version major --no-git-tag-version && pnpm run build",
    "watch": "pnpm run wiki:compile && ng build --watch --configuration development",
    "eslint:show": "npx eslint . --ext .ts,.html",
    "eslint:fix": "npx eslint . --ext .ts,.html --fix"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.2.14",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.2.14",
    "@angular/compiler": "^20.2.14",
    "@angular/core": "^20.2.14",
    "@angular/forms": "^20.2.14",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.2.14",
    "@angular/platform-server": "^20.3.19",
    "@angular/router": "^20.2.14",
    "@angular/ssr": "^20.3.24",
    "mediabunny": "^1.40.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^20.1.1",
    "@angular-eslint/eslint-plugin": "^20.1.1",
    "@angular-eslint/eslint-plugin-template": "^20.1.1",
    "@angular-eslint/schematics": "^20.1.1",
    "@angular-eslint/template-parser": "^20.1.1",
    "@angular/build": "^20.3.19",
    "@angular/cli": "^20.3.19",
    "@angular/compiler-cli": "^20.3.19",
    "@angular/localize": "20.3.19",
    "@eslint/compat": "^1.3.0",
    "@material/layout-grid": "^14.0.0",
    "@ngrx/effects": "^20.1.0",
    "@ngrx/operators": "^20.1.0",
    "@ngrx/router-store": "^20.1.0",
    "@ngrx/store": "^20.1.0",
    "@stylistic/eslint-plugin": "^5.0.0",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "@webgpu/types": "^0.1.63",
    "eslint": "^9.29.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^51.2.3",
    "eslint-plugin-sonarjs": "^3.0.3",
    "eslint-plugin-unused-imports": "^4.1.4",
    "github-slugger": "^2.0.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "marked": "^18.0.6",
    "marked-katex-extension": "^5.1.10",
    "prettier": "^3.6.0",
    "sanitize-html": "^2.17.6",
    "typescript": "~5.8.2"
  }
}
